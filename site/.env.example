# Copy to site/.env.local (git ignores it) and fill in. Never commit real values.

# "Ask the rack" assistant: a key from the Vercel dashboard, AI Gateway tab.
AI_GATEWAY_API_KEY=
# Model id from the AI Gateway model list (default: anthropic/claude-haiku-5.5).
ASSISTANT_MODEL=anthropic/claude-haiku-5.5
# Build the site with the assistant button (needs the /api/ask function: Vercel or `npm run dev`).
VITE_ASSISTANT=1

# Narration: ElevenLabs API key, used only by `node scripts/narrate.ts`.
ELEVENLABS_API_KEY=
